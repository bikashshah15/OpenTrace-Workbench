{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentrace.local/contracts/workbench/v1/schemas/common.schema.json",
  "title": "OpenTrace workbench common definitions v1",
  "type": "object",
  "$defs": {
    "engine_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+#~=,-]{0,159}(?!\\n)$"
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?!\\n)$"
    },
    "hex40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?!\\n)$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?!\\n)$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?!\\n)$"
    },
    "grp_id": {
      "type": "string",
      "pattern": "^grp:[0-9a-f]{24}(?!\\n)$"
    },
    "ctx_id": {
      "type": "string",
      "pattern": "^ctx:[0-9a-f]{24}(?!\\n)$"
    },
    "ast_id": {
      "type": "string",
      "pattern": "^ast:[0-9a-f]{24}(?!\\n)$"
    },
    "occ_id": {
      "type": "string",
      "pattern": "^occ:[0-9a-f]{24}(?!\\n)$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job:[0-9a-f]{24}(?!\\n)$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f]*(?!\\n)$"
    },
    "text_or_empty": {
      "type": "string",
      "minLength": 0,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f]*(?!\\n)$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\u0000-\\u001f]*(?!\\n)$"
    },
    "message": {
      "type": "string",
      "minLength": 0,
      "maxLength": 400,
      "pattern": "^[^\\u0000-\\u001f]*(?!\\n)$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f]*(?!\\n)$"
    },
    "excerpt": {
      "type": "string",
      "minLength": 0,
      "maxLength": 600,
      "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
    },
    "rationale": {
      "type": "string",
      "minLength": 0,
      "maxLength": 900,
      "pattern": "^[^\\u0000-\\u001f]*(?!\\n)$"
    },
    "query": {
      "type": "string",
      "minLength": 0,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001f]*(?!\\n)$"
    },
    "url": {
      "type": "string",
      "minLength": 0,
      "maxLength": 2048,
      "pattern": "^[^\\u0000-\\u001f]*(?!\\n)$"
    },
    "count_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "shown",
        "truncated"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "shown": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason_code",
        "message"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_run",
            "unsupported",
            "failed",
            "partial",
            "completed_empty",
            "completed"
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "disabled",
                "not_configured",
                "upstream_failed",
                "unsupported_ecosystem",
                "invalid_revision",
                "policy_refused",
                "rate_limited",
                "scanner_unavailable",
                "scanner_failed",
                "timeout",
                "output_invalid",
                "cleanup_unverified",
                "partial_coverage",
                "no_applicable_assets",
                "cancelled_by_user",
                "session_ended"
              ]
            }
          ]
        },
        "message": {
          "$ref": "common.schema.json#/$defs/message"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "href",
        "text"
      ],
      "properties": {
        "href": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[^\\u0000-\\u001f]*(?!\\n)$"
            }
          ]
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u001f]*(?!\\n)$"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "owner",
        "name",
        "canonical_url"
      ],
      "properties": {
        "host": {
          "const": "github.com"
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "canonical_url": {
          "$ref": "common.schema.json#/$defs/url"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_digest",
        "repository",
        "commit_sha",
        "requested_ref",
        "generation",
        "mode",
        "assessment"
      ],
      "properties": {
        "analysis_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "repository": {
          "$ref": "common.schema.json#/$defs/repository"
        },
        "commit_sha": {
          "$ref": "common.schema.json#/$defs/hex40"
        },
        "requested_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "enum": [
                "default_branch",
                "branch",
                "tag",
                "commit"
              ]
            },
            "text": {
              "$ref": "common.schema.json#/$defs/text"
            }
          }
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "enum": [
            "live",
            "captured"
          ]
        },
        "assessment": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "schema",
                "validation_digest",
                "bundle_sha256",
                "configuration"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "legacy",
                    "discovery"
                  ]
                },
                "schema": {
                  "const": "opentrace.bombridge_assessment/1"
                },
                "validation_digest": {
                  "$ref": "common.schema.json#/$defs/hex64"
                },
                "bundle_sha256": {
                  "$ref": "common.schema.json#/$defs/hex64"
                },
                "configuration": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[^\\u0000-\\u001f]*(?!\\n)$"
                }
              }
            }
          ]
        }
      }
    },
    "canonical_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_class",
        "record_id",
        "binding"
      ],
      "properties": {
        "record_class": {
          "$ref": "common.schema.json#/$defs/label"
        },
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f]*(?!\\n)$"
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "analysis_digest",
            "session_id",
            "generation",
            "configuration",
            "bundle_sha256"
          ],
          "properties": {
            "analysis_digest": {
              "$ref": "common.schema.json#/$defs/digest"
            },
            "session_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}(?!\\n)$"
            },
            "generation": {
              "type": "integer",
              "minimum": 1
            },
            "configuration": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[^\\u0000-\\u001f]*(?!\\n)$"
            },
            "bundle_sha256": {
              "$ref": "common.schema.json#/$defs/hex64"
            }
          }
        }
      }
    },
    "source_location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "file_sha256",
        "line_start",
        "line_end",
        "excerpt",
        "excerpt_state",
        "link"
      ],
      "properties": {
        "path": {
          "$ref": "common.schema.json#/$defs/path"
        },
        "file_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/hex64"
            }
          ]
        },
        "line_start": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "line_end": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/excerpt"
            }
          ]
        },
        "excerpt_state": {
          "enum": [
            "recorded",
            "unavailable",
            "clipped"
          ]
        },
        "link": {
          "$ref": "common.schema.json#/$defs/link"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_id",
        "producer_version",
        "origin",
        "artifact_id",
        "json_pointer",
        "experimental"
      ],
      "properties": {
        "producer_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(?!\\n)$"
        },
        "producer_version": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000-\\u001f]*(?!\\n)$"
            }
          ]
        },
        "origin": {
          "enum": [
            "original_artifact",
            "supplemental_observation",
            "derived_projection"
          ]
        },
        "artifact_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/engine_id"
            }
          ]
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\u0000-\\u001f]*(?!\\n)$"
            }
          ]
        },
        "experimental": {
          "type": "boolean"
        }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value",
        "basis"
      ],
      "properties": {
        "state": {
          "enum": [
            "recorded",
            "unavailable",
            "unknown"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f]*(?!\\n)$"
            }
          ]
        },
        "basis": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f]*(?!\\n)$"
            }
          ]
        }
      }
    },
    "evidence_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "label",
        "detail",
        "evidence_ref",
        "provenance"
      ],
      "properties": {
        "status": {
          "enum": [
            "source_checked",
            "inventory_reported",
            "declared",
            "unknown",
            "not_assessed",
            "not_applicable",
            "needs_review",
            "advisory_match",
            "captured",
            "represented",
            "not_represented",
            "cannot_establish",
            "conflicting_evidence",
            "no_rule"
          ]
        },
        "label": {
          "$ref": "common.schema.json#/$defs/label"
        },
        "detail": {
          "$ref": "common.schema.json#/$defs/message"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/engine_id"
            }
          ]
        },
        "provenance": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/provenance"
            }
          ]
        }
      }
    }
  }
}

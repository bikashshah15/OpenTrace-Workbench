{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.opentrace.invalid/evidence/v1/capability_request.schema.json",
  "title": "capability_request",
  "type": "object",
  "required": ["kind", "schema_version", "request_id", "requester", "contract_versions"],
  "properties": {
    "kind": {"const": "capability_request"},
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "request_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "requester": {
      "type": "object",
      "required": ["service_id", "implementation"],
      "properties": {
        "service_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "implementation": {"type": "string", "minLength": 1, "maxLength": 32}
      },
      "additionalProperties": false
    },
    "contract_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}},
    "wanted_dimensions": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/dimension"}}
  },
  "additionalProperties": true
}

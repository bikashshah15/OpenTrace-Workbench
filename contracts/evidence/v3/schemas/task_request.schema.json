{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.opentrace.invalid/evidence/v3/task_request.schema.json",
  "title": "task_request",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "task_id",
    "run_id",
    "capability_version",
    "issued_at",
    "deadline",
    "context",
    "requirements",
    "operations",
    "inputs",
    "budget"
  ],
  "properties": {
    "kind": {
      "const": "task_request"
    },
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "capability_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "issued_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "deadline": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "context": {
      "$ref": "common.schema.json#/$defs/context"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "dimension"
        ],
        "properties": {
          "requirement_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "dimension": {
            "$ref": "common.schema.json#/$defs/dimension"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/short_text"
          }
        },
        "additionalProperties": true
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/operation"
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "common.schema.json#/$defs/artifact_ref"
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "max_worker_jobs",
        "max_produced_artifact_bytes"
      ],
      "properties": {
        "max_worker_jobs": {
          "type": "integer",
          "minimum": 0
        },
        "max_produced_artifact_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "capture_set_id": {
      "$ref": "common.schema.json#/$defs/capture_set_id"
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opentrace:schemas:assistant:v1:response",
  "title": "OpenTrace Lab Assistant response v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "turn_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "answer": {"$ref": "#/$defs/answer"},
    "citations": {"type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/citation"}},
    "subject": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/subject"}]},
    "source_states": {"type": "object", "additionalProperties": {"$ref": "#/$defs/source_state"}},
    "limitations": {"type": "array", "maxItems": 24, "items": {"type": "string", "maxLength": 512}},
    "provider": {
      "type": "object", "additionalProperties": false,
      "properties": {"profile": {"type": "string", "maxLength": 64}, "model": {"type": "string", "maxLength": 128}, "validation_level": {"type": "string", "maxLength": 64}},
      "required": ["profile", "model", "validation_level"]
    }
  },
  "required": ["context_id", "turn_id", "answer", "citations", "subject", "source_states", "limitations", "provider"],
  "$defs": {
    "answer": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "answer_status": {"type": "string", "enum": ["answered", "partial", "unknown"]},
        "context_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "turn_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "claims": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/claim"}},
        "limitations": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/answer_limitation"}},
        "next_steps": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/next_step"}}
      },
      "required": ["answer_status", "context_id", "turn_id", "claims", "limitations", "next_steps"]
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["finding", "unknown", "background", "limitation"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence_ids": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      },
      "required": ["kind", "text", "evidence_ids"]
    },
    "answer_limitation": {
      "type": "object", "additionalProperties": false,
      "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 2000}, "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 256}}},
      "required": ["text", "evidence_ids"]
    },
    "next_step": {
      "type": "object", "additionalProperties": false,
      "properties": {"action": {"const": "open_evidence"}, "evidence_id": {"type": "string", "minLength": 1, "maxLength": 256}, "label": {"type": "string", "minLength": 1, "maxLength": 2000}},
      "required": ["action", "evidence_id", "label"]
    },
    "citation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "source": {"type": "string", "enum": ["repository", "dependencies", "advisories", "crypto", "model_observations", "model_correspondence", "candidate_gaps", "bom", "relationships"]},
        "kind": {"type": "string", "maxLength": 64}, "label": {"type": "string", "maxLength": 256},
        "state": {"type": "string", "enum": ["completed", "completed_empty", "not_run", "unavailable", "failed", "partial", "unsupported", "not_compared"]}
      },
      "required": ["evidence_id", "source", "kind", "label", "state"]
    },
    "subject": {
      "type": "object", "additionalProperties": false,
      "properties": {"kind": {"type": "string", "enum": ["analysis", "context", "dependency", "advisory", "crypto", "model", "bom", "relationship"]}, "id": {"type": ["string", "null"], "maxLength": 256}, "label": {"type": "string", "maxLength": 256}},
      "required": ["kind", "id", "label"]
    },
    "source_state": {
      "type": "object", "additionalProperties": false,
      "properties": {"state": {"type": "string", "enum": ["completed", "completed_empty", "not_run", "unavailable", "failed", "partial", "unsupported", "not_compared"]}, "reason_code": {"type": ["string", "null"], "maxLength": 64}, "entry_count": {"type": "integer", "minimum": 0, "maximum": 24}, "truncated": {"type": "boolean"}},
      "required": ["state", "reason_code", "entry_count", "truncated"]
    }
  }
}
